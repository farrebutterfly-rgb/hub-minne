# Mapp med markdown som ska bli sökbar
MINNE_KALLA=./vault
# Mappar under kallan som inte indexeras, kommaseparerat
MINNE_UTESLUT=_arkiv
# Postgres med pgvector
MINNE_PG=postgres://localhost:5432/minne
# OpenAI-kompatibel lokal server (LM Studio, Ollama eller vLLM)
MINNE_LLM_URL=http://127.0.0.1:1234/v1
MINNE_EMBED_MODELL=text-embedding-nomic-embed-text-v1.5
MINNE_CHATT_MODELL=qwen/qwen3.5-9b
MINNE_PORT=4300
